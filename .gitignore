# Root-level ignores for JobPilot AI

# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.python-version
.venv/
venv/
backend/venv/
backend/.venv/
*.env
*.env.*
!.env.example
backend/.env
frontend/.env
backend/jobpilot.db
backend/*.db
**/*.sqlite3
backend/app/vector_store.json
backend/app/chroma_db/
test_chroma/

# Node / frontend artifacts
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/.cache/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and IDE files
.vscode/
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.user
*.userosscache
*.sln.docstates

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
