# Mistral AI API key for text generation and embeddings
MISTRAL_API_KEY=your_mistral_api_key_here

# Database Configuration
# Local development (SQLite default):
DATABASE_URL=sqlite:///./jobpilot.db
# Production (Neon PostgreSQL — paste your connection string from neon.tech dashboard):
# DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Adzuna API credentials for job search
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# RapidAPI key for JSearch API
RAPIDAPI_KEY=your_rapidapi_key_here

# Gmail OAuth Credentials (for Phase 10 auto-email feature)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/gmail/callback

# JWT Auth — REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

# CORS — comma-separated list of allowed frontend origins
# ORIGINS=https://jobpilot-web.onrender.com
