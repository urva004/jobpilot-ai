# Mistral AI API key for text generation and embeddings
MISTRAL_API_KEY=your_mistral_api_key_here

# Database Configuration (Defaults to local SQLite database)
DATABASE_URL=sqlite:///./jobpilot.db

# Adzuna API credentials for job search
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# RapidAPI key for JSearch API
RAPIDAPI_KEY=your_rapidapi_key_here
